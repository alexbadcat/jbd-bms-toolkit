# jbd2mqtt.env — скопіюй у jbd2mqtt.env (той самий каталог) і заповни своїми
# значеннями. Формат: KEY=VALUE, # — коментар, пробіли навколо = обрізаються.
# Цей файл читають jbd2mqtt.py і jbd_logger.py напряму (HERE/jbd2mqtt.env).
# Решта скриптів (jbd_bms.py, jbd_settings.py, balance_mode.py,
# bms_probe_multi.py, esup_factory_reset.py, jbd_analyze.py,
# top_spread_seed_from_ha.py) читають ЗВИЧАЙНІ змінні середовища (export або
# EnvironmentFile у systemd) — якщо запускаєш їх вручну з тим самим шеллом, що
# й цей .env, зроби `set -a; . ./jbd2mqtt.env; set +a` перед запуском.

# ── MQTT ──────────────────────────────────────────────────────────────────
# Адреса MQTT-брокера (Mosquitto тощо). За замовчуванням у коді — "localhost".
MQTT_HOST=localhost
MQTT_PORT=1883
# Лиши порожніми, якщо брокер без авторизації.
MQTT_USER=
MQTT_PASS=

# ── Серійний порт ────────────────────────────────────────────────────────
# USB-RS485 адаптер (FTDI), 9600 8N1. Прив'яжи стале імʼя через udev-правило
# (deploy/udev/99-rs485.rules), щоб /dev/ttyUSBx не "плавало" після ребуту.
SERIAL_PORT=/dev/ttyUSB0
# Та сама змінна в скриптах, які не читають jbd2mqtt.env (BMS_PORT), —
# виставляй однаково з SERIAL_PORT, якщо гониш їх зі свого шела/systemd.
BMS_PORT=/dev/ttyUSB0

# ── Паки на шині ─────────────────────────────────────────────────────────
# Адреси (DIP на BMS) усіх паків на спільній RS485-шині, через кому.
# addr 0 — зазвичай майстер/перший пак; читається jbd2mqtt у тому порядку.
BMS_ADDRS=0

# Які з цих адрес говорять "новим" протоколом ES-UP (а не класичним DD).
# Порожньо/не задано → дефолт: лише addr 0 вважається "старою" DD-адресою,
# усе інше — ES-UP (той самий дефолт, що був захардкоджений раніше).
# Приклад для двох паків, де addr 1 — ES-UP: BMS_ESUP_ADDRS=1
BMS_ESUP_ADDRS=

# Адреса одного конкретного ES-UP-пака для esup_factory_reset.py (сам скрипт
# працює з одним паком за раз).
BMS_ESUP_ADDR=1

# Куди esup_factory_reset.py пише бекапи регістрів перед factory reset.
BMS_BACKUP_DIR=backups

# ── Опитування / поведінка демона ───────────────────────────────────────
POLL_INTERVAL=30
# Слідкувач режиму балансування (balance_mode.py): 1 = увімкнено (дефолт),
# 0/false = вимкнено без правки коду.
BALANCE_MODE_FOLLOW=1

# ── jbd_logger.py ────────────────────────────────────────────────────────
# Секунд між рядками CSV-логу (окрема env-змінна, поза цим .env-файлом —
# задавай її у середовищі процесу, напр. у systemd-юніті чи перед запуском).
LOG_EVERY=60

# ── Home Assistant REST API (jbd_analyze.py, top_spread_seed_from_ha.py) ──
# Довгоживучий токен: профіль користувача HA → Security → Long-Lived Access
# Tokens. Ці дві змінні читаються з env АБО з .env поряд зі скриптом (не з
# цього файлу) — можеш покласти їх сюди ж і підхопити тим самим `set -a`.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Префікс entity_id сенсорів BMS у HA (sensor.<prefix>_komirka_1 і т.д.) —
# звір зі своєю інсталяцією.
HA_BMS_ENTITY_PREFIX=batareia_deye_bms

# entity_id сенсора "дельта комірок" на кожен пак (top_spread_seed_from_ha.py)
# та людська назва для логів.
HA_DELTA_SENSOR_0=sensor.batareia_deye_bms_delta_komirok
HA_DELTA_LABEL_0=pack 0
HA_DELTA_SENSOR_1=sensor.batareia_deye_bms_2_delta_komirok
HA_DELTA_LABEL_1=pack 1
